# Образец .env для VPN Director.
# Скопируйте в .env рядом с vpndirector.jar и заполните своими значениями.
# Формат — properties (KEY=value): кавычки не нужны (станут частью значения), комментарии — только
# отдельной строкой. Значение идёт до конца строки целиком: "KEY=value # комментарий" превратит
# " # комментарий" в часть значения.

# Порт, который слушает приложение
SERVER_PORT=8080

# Базовый путь, если nginx проксирует не с корня
SERVER_CONTEXT_PATH=/

# Смещение от UTC в часах для отображения времени (3 = UTC+3, Москва)
SERVER_TIMEZONE=3

# Каталог OpenVPN
OPENVPN_ROOT=/etc/openvpn

# Имя конфигурационного файла сервера
OPENVPN_CONFIG_FILE_NAME=server.conf

# Кодировка конфига. Пустое значение — определять автоматически
# (но могут быть проблемы с кириллицей в конфиге)
OPENVPN_CONFIG_ENCODING=Windows-1251

# Путь к скриптам easy-rsa
OPENVPN_EASY_RSA_PATH=/etc/openvpn/easy-rsa/2.0

# Имя файла статуса OpenVPN (в каталоге OPENVPN_ROOT)
OPENVPN_STATUS_FILE_NAME=openvpn-status1194.log

# Префикс systemd unit (результат: openvpn-server@server для server.conf)
OPENVPN_SYSTEMD_UNIT_PREFIX=openvpn-server

# Логин для входа в веб-интерфейс
SECURITY_USER_NAME=admin

# Пароль для входа в веб-интерфейс. ОБЯЗАТЕЛЬНЫЙ: без него приложение не стартует.
# Символ "\" в значении не используйте (в .env он является escape-символом).
SECURITY_USER_PASSWORD=admin_change_me

# --- Защита от перебора пароля (необязательно) ---
# Неудачных попыток до блокировки IP
#SECURITY_BRUTEFORCE_MAX_ATTEMPTS=3
# Длительность блокировки, минут
#SECURITY_BRUTEFORCE_LOCK_MINUTES=15
# Окно, в котором суммируются неудачи, минут
#SECURITY_BRUTEFORCE_FAILURE_WINDOW_MINUTES=10
# Адреса прокси, которым доверяем X-Real-IP / X-Forwarded-For (через запятую).
# По умолчанию 127.0.0.1,::1 — nginx на том же хосте.
#SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
